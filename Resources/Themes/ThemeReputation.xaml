<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Reputation (Oscuro/Edge: negros, grises, rojos sangre, plateados) -->
    <Color x:Key="PrimaryLightColor">#FF2D2D2D</Color>
    <Color x:Key="PrimaryColor">#FF1A1A1A</Color>
    <Color x:Key="PrimaryDarkColor">#FF0D0D0D</Color>
    <Color x:Key="AccentColor">#FF8B0000</Color>
    <Color x:Key="AccentDarkColor">#FF6B0000</Color>
    <Color x:Key="BackgroundColor">#FF121212</Color>
    <Color x:Key="SurfaceColor">#FF1E1E1E</Color>
    <Color x:Key="SurfaceVariantColor">#FF2D2D2D</Color>
    <Color x:Key="OnPrimaryColor">#FFF5F5F5</Color>
    <Color x:Key="OnBackgroundColor">#FFF0F0F0</Color>
    <Color x:Key="OnSurfaceColor">#FFE0E0E0</Color>
    <Color x:Key="ErrorColor">#FFFF4444</Color>
    <Color x:Key="SuccessColor">#FF00CC66</Color>
    <Color x:Key="OutlineColor">#FF3D3D3D</Color>
    <Color x:Key="ShadowColor">#4A000000</Color>
    <Color x:Key="BackButtonColor">#FFFFFFFF</Color>

    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceVariantBrush" Color="{StaticResource SurfaceVariantColor}"/>
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="{StaticResource OnPrimaryColor}"/>
    <SolidColorBrush x:Key="OnBackgroundBrush" Color="{StaticResource OnBackgroundColor}"/>
    <SolidColorBrush x:Key="OnSurfaceBrush" Color="{StaticResource OnSurfaceColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="OutlineBrush" Color="{StaticResource OutlineColor}"/>
    <SolidColorBrush x:Key="ShadowBrush" Color="{StaticResource ShadowColor}"/>
    <SolidColorBrush x:Key="BackButtonBrush" Color="{StaticResource BackButtonColor}"/>

    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF2D2D2D" Offset="0"/>
        <GradientStop Color="#FF1A1A1A" Offset="0.5"/>
        <GradientStop Color="#FF8B0000" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BackgroundGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF121212" Offset="0"/>
        <GradientStop Color="#FF1A1A1A" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF252525" Offset="0"/>
        <GradientStop Color="#FF1E1E1E" Offset="1"/>
    </LinearGradientBrush>

    <!-- Tokens de identidad por tema (Reputation: oscuro, anguloso, rojo sangre) -->
    <FontFamily x:Key="DefaultFont">Segoe UI Variable, Segoe UI, Arial</FontFamily>
    <FontFamily x:Key="HeadingFont">Segoe UI Variable Display, Segoe UI, Arial</FontFamily>
    <SolidColorBrush x:Key="TaskbarBrush" Color="#FF1A1A1A"/>
    <SolidColorBrush x:Key="DecorativeBrush" Color="#338B0000"/>
    <SolidColorBrush x:Key="DecorativeBrush2" Color="#334D4D4D"/>
    <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#FF2D1A1A"/>
    <CornerRadius x:Key="RadiusTheme">6</CornerRadius>
    <Thickness x:Key="CardBorderThickness">1.5</Thickness>
    <SolidColorBrush x:Key="DesktopDescriptionBrush" Color="#FFE8E0E0"/>
    <SolidColorBrush x:Key="DesktopIconBrush" Color="#FFD4AF37"/>
    <SolidColorBrush x:Key="AuthMutedBrush" Color="#FFD8CECE"/>
    <SolidColorBrush x:Key="AuthInfoBrush" Color="#FFB8C8D8"/>
    <SolidColorBrush x:Key="AuthPercentBrush" Color="#FFFF8A80"/>
    <SolidColorBrush x:Key="AuthTitleBrush" Color="#FFD4AF37"/>
    <SolidColorBrush x:Key="SettingsIconBrush" Color="#FFFFFFFF"/>

</ResourceDictionary>