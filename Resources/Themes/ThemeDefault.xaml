<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Default (Rosa Pastel) -->
    <Color x:Key="PrimaryLightColor">#FFF0F4F8</Color>
    <Color x:Key="PrimaryColor">#FFF8BBD0</Color>
    <Color x:Key="PrimaryDarkColor">#FFF48FB1</Color>
    <Color x:Key="AccentColor">#FFEC407A</Color>
    <Color x:Key="AccentDarkColor">#FFD81B60</Color>
    <Color x:Key="BackgroundColor">#FFFCE4EC</Color>
    <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="SurfaceVariantColor">#FFFCE4EC</Color>
    <Color x:Key="OnPrimaryColor">#FF4A148C</Color>
    <Color x:Key="OnBackgroundColor">#FF3E2723</Color>
    <Color x:Key="OnSurfaceColor">#FF4E342E</Color>
    <Color x:Key="ErrorColor">#FFEF5350</Color>
    <Color x:Key="SuccessColor">#FF66BB6A</Color>
    <Color x:Key="OutlineColor">#FFE0B8C8</Color>
    <Color x:Key="ShadowColor">#1AF48FB1</Color>
    <Color x:Key="BackButtonColor">#FFF48FB1</Color>

    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceVariantBrush" Color="{StaticResource SurfaceVariantColor}"/>
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="{StaticResource OnPrimaryColor}"/>
    <SolidColorBrush x:Key="OnBackgroundBrush" Color="{StaticResource OnBackgroundColor}"/>
    <SolidColorBrush x:Key="OnSurfaceBrush" Color="{StaticResource OnSurfaceColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="OutlineBrush" Color="{StaticResource OutlineColor}"/>
    <SolidColorBrush x:Key="ShadowBrush" Color="{StaticResource ShadowColor}"/>
    <SolidColorBrush x:Key="BackButtonBrush" Color="{StaticResource BackButtonColor}"/>

    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFF8BBD0" Offset="0"/>
        <GradientStop Color="#FFF48FB1" Offset="0.5"/>
        <GradientStop Color="#FFEC407A" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BackgroundGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFFFF" Offset="0"/>
        <GradientStop Color="#FFFCE4EC" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFFFF" Offset="0"/>
        <GradientStop Color="#FFFFF0F5" Offset="1"/>
    </LinearGradientBrush>

    <!-- Tokens de identidad por tema -->
    <FontFamily x:Key="DefaultFont">Segoe UI Variable, Segoe UI, Arial</FontFamily>
    <FontFamily x:Key="HeadingFont">Segoe UI Variable Display, Segoe UI, Arial</FontFamily>
    <SolidColorBrush x:Key="TaskbarBrush" Color="#E6FFFFFF"/>
    <SolidColorBrush x:Key="DecorativeBrush" Color="#1AF8BBD0"/>
    <SolidColorBrush x:Key="DecorativeBrush2" Color="#1AEC407A"/>
    <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#FFFCE4EC"/>
    <CornerRadius x:Key="RadiusTheme">12</CornerRadius>
    <Thickness x:Key="CardBorderThickness">1</Thickness>
    <SolidColorBrush x:Key="DesktopDescriptionBrush" Color="#FFF48FB1"/>
    <SolidColorBrush x:Key="DesktopIconBrush" Color="#FFD81B60"/>
    <SolidColorBrush x:Key="AuthMutedBrush" Color="#FFF48FB1"/>
    <SolidColorBrush x:Key="AuthInfoBrush" Color="#FFF8BBD0"/>
    <SolidColorBrush x:Key="AuthPercentBrush" Color="#FFEC407A"/>
    <SolidColorBrush x:Key="AuthTitleBrush" Color="#FFD81B60"/>
    <SolidColorBrush x:Key="SettingsIconBrush" Color="#FFF48FB1"/>

</ResourceDictionary>