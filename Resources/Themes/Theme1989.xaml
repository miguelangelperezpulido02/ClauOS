<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 1989 (Pastel soñador: sky blues, lavenders, mints, creams, golds) -->
    <Color x:Key="PrimaryLightColor">#FFE8F4FD</Color>
    <Color x:Key="PrimaryColor">#FF87CEEB</Color>
    <Color x:Key="PrimaryDarkColor">#FF5DADE2</Color>
    <Color x:Key="AccentColor">#FFFFD700</Color>
    <Color x:Key="AccentDarkColor">#FFF4C542</Color>
    <Color x:Key="BackgroundColor">#FFF0F8FF</Color>
    <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="SurfaceVariantColor">#FFE8F4FD</Color>
    <Color x:Key="OnPrimaryColor">#FF1A3A5C</Color>
    <Color x:Key="OnBackgroundColor">#FF2C3E50</Color>
    <Color x:Key="OnSurfaceColor">#FF34495E</Color>
    <Color x:Key="ErrorColor">#FFE74C3C</Color>
    <Color x:Key="SuccessColor">#FF2ECC71</Color>
    <Color x:Key="OutlineColor">#FFB8D4E8</Color>
    <Color x:Key="ShadowColor">#1A87CEEB</Color>

    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceVariantBrush" Color="{StaticResource SurfaceVariantColor}"/>
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="{StaticResource OnPrimaryColor}"/>
    <SolidColorBrush x:Key="OnBackgroundBrush" Color="{StaticResource OnBackgroundColor}"/>
    <SolidColorBrush x:Key="OnSurfaceBrush" Color="{StaticResource OnSurfaceColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="OutlineBrush" Color="{StaticResource OutlineColor}"/>
    <SolidColorBrush x:Key="ShadowBrush" Color="{StaticResource ShadowColor}"/>

    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFE8F4FD" Offset="0"/>
        <GradientStop Color="#FF87CEEB" Offset="0.5"/>
        <GradientStop Color="#FF5DADE2" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BackgroundGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFFFF" Offset="0"/>
        <GradientStop Color="#FFE8F4FD" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFFFF" Offset="0"/>
        <GradientStop Color="#FFE8F4FD" Offset="0.5"/>
        <GradientStop Color="#FFF0F8FF" Offset="1"/>
    </LinearGradientBrush>

    <!-- Tokens de identidad por tema (1989: pastel soñador, aireado, dorado) -->
    <FontFamily x:Key="DefaultFont">Segoe UI Variable, Segoe UI, Arial</FontFamily>
    <FontFamily x:Key="HeadingFont">Segoe UI Variable Display, Segoe UI, Arial</FontFamily>
    <SolidColorBrush x:Key="TaskbarBrush" Color="#E6F0F8FF"/>
    <SolidColorBrush x:Key="DecorativeBrush" Color="#4087CEEB"/>
    <SolidColorBrush x:Key="DecorativeBrush2" Color="#40FFD700"/>
    <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#FFFDECEA"/>
    <CornerRadius x:Key="RadiusTheme">18</CornerRadius>
    <Thickness x:Key="CardBorderThickness">1</Thickness>
    <SolidColorBrush x:Key="DesktopDescriptionBrush" Color="#FF5DADE2"/>
    <SolidColorBrush x:Key="DesktopIconBrush" Color="#FFF4C542"/>
    <SolidColorBrush x:Key="AuthMutedBrush" Color="#FF5DADE2"/>
    <SolidColorBrush x:Key="AuthInfoBrush" Color="#FF87CEEB"/>
    <SolidColorBrush x:Key="AuthPercentBrush" Color="#FFFFD700"/>
    <SolidColorBrush x:Key="AuthTitleBrush" Color="#FFF4C542"/>

</ResourceDictionary>