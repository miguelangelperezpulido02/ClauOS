<UserControl x:Class="ClauOS.Views.FoodTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:ClauOS.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="700">

    <ScrollViewer Style="{StaticResource ModernScrollViewerStyle}" Padding="24">
        <StackPanel MaxWidth="720" HorizontalAlignment="Center"
                    RequestBringIntoView="OnRequestBringIntoView">

            <!-- Cabecera -->
            <Grid Margin="0,40,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Content="← Volver"
                        Style="{StaticResource GhostButtonStyle}"
                        Foreground="{DynamicResource BackButtonBrush}"
                        VerticalAlignment="Center"
                        FontSize="21" Padding="12,6"
                        Click="BackButton_Click"/>
                <TextBlock Grid.Column="1" Text="🍴 Comida aleatoria"
                           Style="{StaticResource Heading2Style}"
                           TextAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <!-- Filtros por categoría -->
            <ListBox ItemsSource="{Binding Filters}"
                     SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0"
                     Margin="0,0,0,16"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,0,8,8"/>
                        <Setter Property="Padding" Value="16,8"/>
                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="{DynamicResource RadiusTheme}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource PrimaryGradientBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <!-- Tarjeta de resultado -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16" MinHeight="230">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayedEmoji}"
                               FontSize="64" HorizontalAlignment="Center"
                               Foreground="{DynamicResource DesktopIconBrush}"/>
                    <TextBlock Text="{Binding DisplayedName}"
                               Style="{StaticResource Heading2Style}"
                               TextAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    <Border Background="{DynamicResource PrimaryGradientBrush}"
                            CornerRadius="{DynamicResource RadiusTheme}"
                            Padding="14,4" Margin="0,12,0,0"
                            HorizontalAlignment="Center"
                            Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding DisplayedCategory}"
                                   Foreground="{DynamicResource OnPrimaryBrush}"
                                   FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Text="{Binding FunPhrase}"
                               Style="{StaticResource BodyStyle}"
                               TextAlignment="Center" Margin="0,12,0,0"
                               Foreground="{DynamicResource DesktopDescriptionBrush}"
                               FontStyle="Italic" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Botón de sorteo -->
            <Button Content="🎲 ¡Elige por mí!"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding PickCommand}"
                    IsEnabled="{Binding IsPicking, Converter={StaticResource InverseBoolConverter}}"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,12" MinWidth="230" Height="52" FontSize="16"/>

            <!-- Mostrar / ocultar gestión -->
            <Button Content="⚙️ Gestionar comidas"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding ToggleManagementCommand}"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,16" MinWidth="230"
                    Visibility="{Binding IsManagementVisible, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
            <Button Content="Ocultar comidas"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding ToggleManagementCommand}"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,16" MinWidth="230"
                    Visibility="{Binding IsManagementVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <!-- Mis comidas -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,24"
                    Visibility="{Binding IsManagementVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Mis comidas"
                               Style="{StaticResource Heading3Style}" Margin="0,0,0,12"/>

                    <ListView ItemsSource="{Binding FilteredFoods}"
                              MaxHeight="240"
                              Background="Transparent" BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Emoji}" FontSize="24"
                                               VerticalAlignment="Center" Margin="0,0,12,0"
                                               Foreground="{DynamicResource DesktopIconBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   Style="{StaticResource BodyStyle}"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Category}"
                                                   Style="{StaticResource CaptionStyle}"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="✏️"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Command="{Binding DataContext.EditFoodCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Padding="8,4" Margin="4,0"/>
                                    <Button Grid.Column="3" Content="🗑️"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Command="{Binding DataContext.DeleteFoodCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Padding="8,4"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Separator Style="{StaticResource ModernSeparatorStyle}" Margin="0,16"/>

                    <TextBlock Text="Añadir comida"
                               Style="{StaticResource CaptionStyle}" Margin="0,0,0,8"
                               Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                    <TextBlock Text="Editar comida"
                               Style="{StaticResource CaptionStyle}" Margin="0,0,0,8"
                               Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <TextBox Text="{Binding InputName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding Source={x:Static vm:FoodTabViewModel.EmojiChoices}}"
                                  SelectedItem="{Binding InputEmoji, Mode=TwoWay}"
                                  Margin="0,0,4,0" Padding="12,8" FontSize="16"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding Source={x:Static vm:FoodTabViewModel.Categories}}"
                                  SelectedItem="{Binding InputCategory, Mode=TwoWay}"
                                  Margin="4,0,0,0" Padding="12,8"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar"
                                Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding CancelEditCommand}"
                                Margin="0,0,8,0"
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <Button Content="Añadir"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding SaveFoodCommand}"
                                MinWidth="120"
                                Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        <Button Content="Guardar"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding SaveFoodCommand}"
                                MinWidth="120"
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
