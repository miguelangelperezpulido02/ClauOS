<UserControl x:Class="ClauOS.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ClauOS.Views"
             xmlns:vm="clr-namespace:ClauOS.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:LoginViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="600" d:DesignWidth="400">

    <Grid Background="{DynamicResource BackgroundGradientBrush}">

        <!-- Elementos decorativos de fondo (tintados por tema) -->
        <Canvas x:Name="DecorativeCanvas" IsHitTestVisible="False">
            <Ellipse Width="200" Height="200" Fill="{DynamicResource DecorativeBrush}" Canvas.Left="-80" Canvas.Top="-80"/>
            <Ellipse Width="150" Height="150" Fill="{DynamicResource DecorativeBrush2}" Canvas.Right="-60" Canvas.Bottom="-60"/>
            <Ellipse Width="100" Height="100" Fill="{DynamicResource DecorativeBrush}" Canvas.Left="50" Canvas.Bottom="100"/>
        </Canvas>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource CardGradientBrush}"
                    CornerRadius="{DynamicResource RadiusTheme}"
                    Effect="{StaticResource ShadowMD}"
                    Padding="32"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="1"
                    MaxWidth="420"
                    MinWidth="320">
                
                <StackPanel>
                    <!-- Logo / Icono -->
                    <Border Width="80" Height="80" CornerRadius="40" Margin="0,0,0,24"
                            Background="{DynamicResource PrimaryGradientBrush}"
                            Effect="{StaticResource ShadowMD}">
                        <TextBlock Text="💕" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Título -->
                    <TextBlock Text="ClauOS" Style="{StaticResource Heading1Style}"
                                TextAlignment="Center" Margin="0,0,0,8"
                                Foreground="{DynamicResource OnBackgroundBrush}"/>

                    <TextBlock Text="Inicia sesión para continuar" Style="{StaticResource BodyStyle}"
                                TextAlignment="Center" Margin="0,0,0,32"
                                Foreground="{DynamicResource AuthMutedBrush}"/>

                    <!-- Campo Usuario -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Usuario" Style="{StaticResource CaptionStyle}" Margin="0,0,0,6" Foreground="{DynamicResource AuthMutedBrush}"/>
                        <TextBox x:Name="UsernameBox"
                                 Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 FontSize="16"
                                 Padding="16,12"/>
                    </StackPanel>

                    <!-- Campo Contraseña -->
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Contraseña" Style="{StaticResource CaptionStyle}" Margin="0,0,0,6" Foreground="{DynamicResource AuthMutedBrush}"/>
                        <PasswordBox x:Name="PasswordBox"
                                     Style="{StaticResource ModernPasswordBoxStyle}"
                                     FontSize="16"
                                     Padding="16,12"
                                     PasswordChanged="PasswordBox_PasswordChanged"
                                     KeyDown="PasswordBox_KeyDown"/>
                    </StackPanel>

                    <!-- Mensaje de error -->
                    <Border x:Name="ErrorBorder"
                            Background="{DynamicResource ErrorBackgroundBrush}"
                            BorderBrush="{DynamicResource ErrorBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMD}"
                            Padding="12"
                            Margin="0,0,0,16"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="⚠" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" x:Name="ErrorText" Text="{Binding ErrorMessage}"
                                       Style="{StaticResource BodyStyle}"
                                       Foreground="{DynamicResource ErrorBrush}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Botón Login -->
                    <Button Content="Iniciar Sesión"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding LoginCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                            Height="52"
                            FontSize="16"
                            FontWeight="SemiBold">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="LoadingText" Text=" ✨" VerticalAlignment="Center" Opacity="0"/>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                        <Setter TargetName="LoadingText" Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>

                    <!-- Hint -->
                    <TextBlock Text="Usuario: Claudia  •  Contraseña: claudia"
                                Style="{StaticResource CaptionStyle}"
                                TextAlignment="Center"
                                Margin="0,20,0,0"
                                Opacity="0.6"
                                FontSize="11"
                                Foreground="{DynamicResource AuthMutedBrush}"/>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>