<UserControl x:Class="ClauOS.Views.SplashView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ClauOS.Views"
             xmlns:vm="clr-namespace:ClauOS.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SplashViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid Background="{DynamicResource BackgroundGradientBrush}">

        <!-- Partículas decorativas flotantes (tintadas por tema) -->
        <Canvas x:Name="ParticlesCanvas" IsHitTestVisible="False">
            <Canvas.Resources>
                <Style TargetType="Ellipse">
                    <Setter Property="Fill" Value="{DynamicResource DecorativeBrush2}"/>
                    <Setter Property="Opacity" Value="0"/>
                </Style>
            </Canvas.Resources>
        </Canvas>

        <Viewbox StretchDirection="DownOnly" Stretch="Uniform">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Style="{StaticResource CardStyle}"
                    MinWidth="400" MaxWidth="500"
                    Margin="40"
                    Effect="{StaticResource ShadowLG}">
                
                <StackPanel>
                    <!-- Logo animado -->
                    <Border x:Name="LogoBorder" Width="100" Height="100" CornerRadius="50"
                            Margin="0,0,0,32"
                            Background="{DynamicResource PrimaryGradientBrush}"
                            Effect="{StaticResource ShadowMD}"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="LogoScale" ScaleX="1" ScaleY="1"/>
                                <RotateTransform x:Name="LogoRotate" Angle="0"/>
                            </TransformGroup>
                        </Border.RenderTransform>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="LogoScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         From="1" To="1.05" Duration="0:0:2"
                                                         EasingFunction="{StaticResource EaseInOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="LogoScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         From="1" To="1.05" Duration="0:0:2"
                                                         EasingFunction="{StaticResource EaseInOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="LogoRotate"
                                                         Storyboard.TargetProperty="Angle"
                                                         From="-3" To="3" Duration="0:0:3"
                                                         EasingFunction="{StaticResource EaseInOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                        <TextBlock Text="💕" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Título -->
                    <TextBlock Text="ClauOS" Style="{StaticResource Heading1Style}"
                                TextAlignment="Center" Margin="0,0,8,0"
                                Foreground="{DynamicResource OnBackgroundBrush}"/>

                    <!-- Subtítulo -->
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Heading3Style}"
                                TextAlignment="Center" Margin="0,0,0,8"
                                Foreground="{DynamicResource AuthMutedBrush}"/>

                    <TextBlock x:Name="SubMessageText" Text="{Binding SubMessage}"
                                Style="{StaticResource BodyStyle}"
                                TextAlignment="Center" Margin="0,0,0,32"
                                Foreground="{DynamicResource AuthInfoBrush}"
                                FontStyle="Italic"/>

                    <!-- Barra de progreso -->
                    <Border Width="280" Height="8" Background="{DynamicResource OutlineBrush}"
                            CornerRadius="4" Margin="0,0,0,16">
                        <Border x:Name="ProgressFill"
                                Width="0" Height="8"
                                Background="{DynamicResource PrimaryGradientBrush}"
                                CornerRadius="4"
                                HorizontalAlignment="Left">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="ProgressScale" ScaleX="0" ScaleY="1"/>
                            </Border.RenderTransform>
                        </Border>
                    </Border>

                    <!-- Porcentaje -->
                    <TextBlock Text="{Binding Progress, StringFormat='{}{0:F0}%'}"
                                Style="{StaticResource CaptionStyle}"
                                TextAlignment="Center"
                                FontWeight="Medium"
                                Foreground="{DynamicResource AuthPercentBrush}"/>
                </StackPanel>
            </Border>
        </Viewbox>

        <!-- Mensaje de bienvenida final (overlay) -->
        <Border x:Name="WelcomeOverlay"
                Background="{DynamicResource TaskbarBrush}"
                Visibility="Collapsed"
                Panel.ZIndex="100">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource CardGradientBrush}"
                    CornerRadius="{DynamicResource RadiusTheme}"
                    Effect="{StaticResource ShadowLG}"
                    Padding="48,32">
                <StackPanel>
                    <TextBlock Text="💖" FontSize="64" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock x:Name="WelcomeText" Text="¡Bienvenida, Claudia!"
                                Style="{StaticResource Heading1Style}"
                                TextAlignment="Center"
                                Foreground="{DynamicResource AuthTitleBrush}"/>
                    <TextBlock Text="Abriendo ClauOS..." Style="{StaticResource BodyStyle}"
                                TextAlignment="Center" Margin="0,16,0,0"
                                Foreground="{DynamicResource AuthMutedBrush}"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>