<UserControl x:Class="ClauOS.Views.TicketsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:ClauOS.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TicketsTabViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="700" d:DesignWidth="700">

    <Grid>
    <ScrollViewer Style="{StaticResource ModernScrollViewerStyle}" Padding="24">
        <StackPanel MaxWidth="720" HorizontalAlignment="Center"
                    RequestBringIntoView="OnRequestBringIntoView">

            <!-- Cabecera -->
            <Grid Margin="0,24,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Content="← Volver"
                        Style="{StaticResource GhostButtonStyle}"
                        VerticalAlignment="Center"
                        FontSize="16" Padding="8,4"
                        Click="BackButton_Click"/>
                <TextBlock Grid.Column="1" Text="🎫 Tickets de amor"
                           Style="{StaticResource Heading2Style}"
                           TextAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <TextBlock Text="CANJEA MOMENTOS ESPECIALES"
                       Style="{StaticResource BodyStyle}"
                       Foreground="{DynamicResource OnBackgroundBrush}"
                       FontSize="20"
                       TextAlignment="Center"
                       Margin="0,8,0,24"/>

            <!-- Reset dev (solo visible en depuración) -->
            <Button Content="DEV: reiniciar tickets"
                    Style="{StaticResource GhostButtonStyle}"
                    Command="{Binding DevResetTicketsCommand}"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,16"
                    Visibility="{Binding IsDevResetVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <!-- Resumen -->
            <Border Style="{StaticResource CardStyle}"
                    Background="{DynamicResource PrimaryGradientBrush}"
                    BorderThickness="0"
                    CornerRadius="{DynamicResource RadiusTheme}"
                    Padding="20"
                    Margin="0,0,0,16">
                <TextBlock Text="{Binding Summary}"
                           Style="{StaticResource BodyStyle}"
                           TextAlignment="Center"
                           Foreground="{DynamicResource OnPrimaryBrush}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- Lista de tickets -->
            <ItemsControl ItemsSource="{Binding Groups}"
                          Margin="0,0,0,24">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="{DynamicResource RadiusTheme}"
                                Margin="0,0,0,8" Padding="20">
                            <Border.RenderTransform>
                                <TranslateTransform Y="20"/>
                            </Border.RenderTransform>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1" Duration="0:0:0.4"
                                                             FillBehavior="Stop"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                             From="20" To="0" Duration="0:0:0.4">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                    <Setter Property="Opacity" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Available}" Value="0">
                                            <Setter Property="Opacity" Value="0.55"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Emoji}"
                                           FontFamily="Segoe UI Symbol"
                                           FontSize="42"
                                           VerticalAlignment="Center"
                                           Margin="0,0,16,0"
                                           Foreground="{DynamicResource DesktopIconBrush}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}"
                                               Style="{StaticResource Heading3Style}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Description}"
                                               Style="{StaticResource CaptionStyle}"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource DesktopDescriptionBrush}"/>
                                    <TextBlock Margin="0,8,0,0"
                                               Style="{StaticResource CaptionStyle}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource DesktopIconBrush}">
                                        <Run Text="Disponibles: "/><Run Text="{Binding Available, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Button Content="Canjear"
                                            Command="{Binding DataContext.RequestRedeemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Padding="16,8" MinWidth="110">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Available}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Border Background="{DynamicResource PrimaryGradientBrush}"
                                            CornerRadius="{DynamicResource RadiusTheme}"
                                            Padding="14,8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Available}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="AGOTADO"
                                                   Foreground="{DynamicResource OnPrimaryBrush}"
                                                   FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>

        <!-- Overlay confirmación de canje -->
        <Border Background="#99000000"
                Padding="24"
                Visibility="{Binding IsConfirmVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Style="{StaticResource CardStyle}"
                    DataContext="{Binding PendingGroup}"
                    CornerRadius="{DynamicResource RadiusTheme}"
                    Padding="32"
                    MaxWidth="480"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding Emoji}"
                               FontFamily="Segoe UI Symbol"
                               FontSize="64"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource DesktopIconBrush}"/>
                    <TextBlock Style="{StaticResource Heading2Style}"
                               TextAlignment="Center"
                               Margin="0,16,0,0"
                               TextWrapping="Wrap">
                        <Run Text="¿Canjear "/><Run Text="{Binding Title, Mode=OneWay}"/><Run Text="?"/>
                    </TextBlock>
                    <TextBlock Text="{Binding Description}"
                               Style="{StaticResource BodyStyle}"
                               TextAlignment="Center"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource DesktopDescriptionBrush}"/>
                    <TextBlock Style="{StaticResource BodyStyle}"
                               TextAlignment="Center"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap"
                               FontStyle="Italic"
                               Foreground="{DynamicResource DesktopDescriptionBrush}">
                        <Run Text="Ahora tienes "/><Run Text="{Binding Available, Mode=OneWay}" FontWeight="Bold"/><Run Text=". Esta acción no se puede deshacer."/>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                        <Button Content="Sí, canjear"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding DataContext.ConfirmPendingRedeemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Margin="0,0,8,0" MinWidth="150" Height="52" FontSize="16"/>
                        <Button Content="Cancelar"
                                Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding DataContext.CancelRedeemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                MinWidth="130" Height="52" FontSize="16"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Overlay celebración: ticket canjeado en grande -->
        <Border Background="#99000000"
                Padding="24"
                Visibility="{Binding IsCelebrationVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Style="{StaticResource CardStyle}"
                    DataContext="{Binding CelebratedTicket}"
                    CornerRadius="{DynamicResource RadiusTheme}"
                    Padding="32"
                    MaxWidth="480"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding Emoji}"
                               FontFamily="Segoe UI Symbol"
                               FontSize="96"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource DesktopIconBrush}"/>
                    <TextBlock Text="{Binding Title}"
                               Style="{StaticResource Heading2Style}"
                               TextAlignment="Center"
                               Margin="0,16,0,0"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Description}"
                               Style="{StaticResource BodyStyle}"
                               TextAlignment="Center"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource DesktopDescriptionBrush}"/>
                    <Border Background="{DynamicResource PrimaryGradientBrush}"
                            CornerRadius="{DynamicResource RadiusTheme}"
                            Padding="14,8"
                            Margin="0,20,0,0"
                            HorizontalAlignment="Center">
                        <TextBlock Foreground="{DynamicResource OnPrimaryBrush}"
                                   FontWeight="Bold" FontSize="16">
                            <Run Text="CANJEADO EL "/><Run Text="{Binding RedeemedAtText, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>
                    <Button Content="Volver a mis tickets"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding DataContext.CloseCelebrationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            HorizontalAlignment="Center"
                            Margin="0,24,0,0" MinWidth="230" Height="52" FontSize="16"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
